# ===== 秘密情報(絶対にコミットしない) =====
# DBパスワード・JWT署名キーなどを含む環境変数ファイル
.env
.env.*
# 値を入れていない雛形はコミットする
!.env.example
# ローカル開発用の接続情報
backend/src/main/resources/application-local.properties

# ===== Terraform =====
# ステートファイルには設定値が平文で入るためコミットしない
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
# 自分のIP・DBパスワードなど環境固有の値
infra/terraform.tfvars
infra/*.auto.tfvars

# ===== バックエンド(Spring Boot / Gradle) =====
backend/.gradle/
backend/build/
backend/bin/
backend/out/
# ローカルに保存したアップロード画像
backend/uploads/

# ===== フロントエンド(React / Vite) =====
frontend/node_modules/
frontend/dist/

# ===== E2Eテスト・ブラウザ性能テスト(Playwright) =====
e2e/node_modules/
# 失敗したときのトレース・スクリーンショット・動画と、HTMLのレポート
e2e/test-results/
e2e/test-results-perf/
e2e/playwright-report/
e2e/playwright-report-perf/
e2e/blob-report/
# テスト用にビルドした画面(npm run build の dist/ とは別)
frontend/dist-e2e/

# ===== 性能テスト(k6) =====
# 計測結果(レポートのHTML・集計のJSON)は実行するたびに作られるのでコミットしない
perf/results/*
!perf/results/.gitkeep

# ===== API仕様書 =====
# npm run build:api-doc で作るHTML(GitHub Actions の成果物からもダウンロードできる)
docs/api/dist/

# ===== エディタ・OS =====
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# ===== Claude Code(個人設定) =====
.claude/settings.local.json

# terraform plan -out で作る実行計画(設定値が入る)
infra/tfplan
