{
  "name": "sns-timeline-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "E2Eテスト・ブラウザ性能テスト(設計書 7-6・7-5、e2e/README.md)",
  "scripts": {
    "db:up": "docker compose --env-file ../backend/.env -f docker-compose.e2e.yml up -d --wait",
    "db:down": "docker compose --env-file ../backend/.env -f docker-compose.e2e.yml down",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "perf": "playwright test --config=playwright.perf.config.js",
    "lint": "oxlint"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "oxlint": "^1.81.0"
  }
}
